{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client", "vitest/globals"],
    "incremental": true,
    "paths": {
      "@extensions/*": ["../extensions/*"],
      "@codemirror/view": ["./node_modules/@codemirror/view"]
    },
    "tsBuildInfoFile": "./tmp/tsc-renderer/check.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "electron/app/proper-lockfile.d.ts"]
}
