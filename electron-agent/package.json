    "motion": "^12.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "virtua": "^0.51.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
