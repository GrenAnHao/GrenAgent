    "png2icons": "^2.0.1",
    "sharp": "^0.35.4",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@aws-sdk/token-providers": "3.1048.0"
  }
