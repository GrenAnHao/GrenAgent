{
  "name": "electron-agent",
  "version": "0.3.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "postinstall": "node ../cli/scripts/patch-pi-shell.mjs . && node ../cli/scripts/patch-pi-edit-preview.mjs .",
    "dev": "electron-vite dev",
    "start": "electron-vite preview --mode localrun",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "typecheck:main": "tsc -p tsconfig.node.json --noEmit --tsBuildInfoFile ./tmp/tsc-node/check.tsbuildinfo",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:main",
    "build": "npm run typecheck && electron-vite build",
    "test": "vitest run",
    "test:codegraph": "node scripts/test-codegraph.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "package": "electron-builder --config electron-builder.yml",
    "ui:check": "node ui-harness/check.mjs",
    "verify-notes": "npx tsx .agents/skills/write-notes-like-deepseek/scripts/verify-agent-note-tree.ts && npx tsx .agents/skills/write-notes-like-deepseek/scripts/verify-agent-note-format.ts && npx tsx .agents/skills/write-notes-like-deepseek/scripts/verify-archived-agent-notes.ts",
    "archive-note": "npx tsx .agents/skills/write-notes-like-deepseek/scripts/archive-agent-note.ts"
  },
