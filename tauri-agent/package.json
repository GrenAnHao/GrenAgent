{
  "name": "grenagent-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest --run",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:codebasememory": "node scripts/build-codebasememory.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lexical/utils": "0.42.0",
    "@lobehub/charts": "^5.4.0",
    "@lobehub/editor": "^4.23.1",
    "@lobehub/ui": "^5.29.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@xyflow/react": "^12.11.2",
    "antd": "^6.6.0",
    "antd-style": "^4.1.0",
    "d3-force": "^3.0.0",
    "lexical": "0.42.0",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "virtua": "^0.49.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "//overrides": "全树只允许一份 React。多个依赖（zustand、@dnd-kit、antd-style、@lobehub/* 等）把 react 声明成精确版本的 peer/optional peer，锁文件把这些 peer 钉在升级前的 19.2.7；bun 会照锁在 node_modules/<pkg>/node_modules/react 下装出第二份 19.2.8 之外的副本。两份 React = 两套 ReactSharedInternals，任何跨副本的 hook 调用都会拿到 null（实测：整套测试 247 例挂在 'Cannot read properties of null (reading useState)'），Context 也读不到彼此的 Provider。overrides 从安装层收敛，比 vite resolve.dedupe 更根本——后者只管打包器解析，管不到 Vitest 的 node 侧解析。",
  "overrides": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
