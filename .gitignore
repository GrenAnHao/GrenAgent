node_modules/
dist/

# 所有以点开头的目录（编辑器 / agent 工具状态、临时目录）一律忽略，任意层级。
# 要入库的点目录在这里放行。
.*/
!.github/

.vite/
.worktrees/
output/
.DS_Store
*.log
.env
.env.local

# Nested pi monorepo (has its own .git)
/pi/

# Reference material
/archive/

# Tool caches / indexes / configs
/.codebase-memory/
/.claude/
/.codex/
/.superpowers/
/openspec/
/.cursor/

# Local code index (tens of MB, rebuilt by `codegraph init`)
/.codegraph/

# Editor / agent tool state (same class as .cursor/.claude/.codex above)
/.idea/
/.agents/
/.codebuddy/

# Debug + throwaway run artifacts
/.playwright-cli/
/.playwright-mcp/
/.tmp-electron-browser/
/electron-agent/.mermaid-repro/
/electron-agent/.runtime/
/electron-agent/D/
/dump-event.err
/.tsc-out.txt
/.tsc-src.txt
/.vitest-out.txt
/.vitest-sync-runner.txt
*.tsbuildinfo

# Windows junk
nul
.pi/

# 预编译入仓的 Windows helper（源码在旁边）。放行，免得被全局的 *.exe 规则挡住。
!/electron-agent/native/bin/*.exe
!/extensions/_shared/sandbox/windows/bin/*.exe

# Local embedding model weights (download on first run)
/embedding/.models/
/embedding/vector-service.exe
/embedding/dist/
