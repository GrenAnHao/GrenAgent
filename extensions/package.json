{
  "name": "pi-extensions-pack",
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "GrenAgent Pi extensions with local knowledge and code retrieval modules.",
  "type": "module",
  "scripts": {
    "postinstall": "node ../cli/scripts/patch-pi-shell.mjs . && node ../cli/scripts/patch-pi-edit-preview.mjs ."
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "rag",
    "web",
    "image",
    "multi-agent"
  ],
  "pi": {
    "extensions": [
      "./web-fetch/index.ts",
      "./image-gen/index.ts",
      "./multi-agent/index.ts",
      "./tts/index.ts"
    ]
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.1",
    "@earendil-works/pi-ai": "1.5.1",
    "@earendil-works/pi-coding-agent": "1.5.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.45.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vscode/ripgrep": "^1.18.0",
    "cheerio": "^1.2.0",
    "diff": "^9.0.0",
    "ignore": "7.0.5",
    "tinyglobby": "^0.2.17",
    "typebox": "*"
  }
}
