import {homedir} from 'node:os';import {join,resolve} from 'node:path';import {readFile} from 'node:fs/promises';
import {ModelRuntime,SettingsManager,getAgentDir} from '../../../cli/src/pi-sdk';import {ModelRuntimeHost} from '../../../electron-agent/electron/agent/modelRuntimeHost';import {createAgentDataModelPort} from '../../../electron-agent/electron/agentData/createAgentDataModelPort';import {knowledgeModelIdentity} from '../../../electron-agent/electron/agentData/knowledgeKernel/coordinator';import {getConfig,refreshConfig,__resetForTest} from '../../../extensions/_shared/runtime-config';
const userData=resolve(process.argv[2]??'');if(!process.argv[2])throw new Error('Usage: bind-only.mts <userData> [agentDir]');const agentDir=resolve(process.argv[3]??process.env.PI_CODING_AGENT_DIR??join(homedir(),'.pi','agent'));process.env.PI_CODING_AGENT_DIR=agentDir;process.env.PI_RUNTIME_CONFIG=join(userData,'runtime-settings.json');globalThis.fetch=async()=>{throw new Error('NETWORK_DISABLED');};
